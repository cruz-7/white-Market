# Development-only example. Never use these values for a production release.

# `npx convex dev` generates the local deployment URL and site URL.
CONVEX_DEPLOYMENT=dev:your-dev-deployment
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Paystack test public key for local development
VITE_PAYSTACK_PUBLIC_KEY=pk_test_replace_me
